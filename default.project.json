{
    "name": "Imperium",
    "emitLegacyScripts": true,

    "tree": {
        "$className": "DataModel",
        "ReplicatedFirst": {
            "$path": "src/ReplicatedFirst"
        },
        "ServerScriptService": {
            "$path": "src/ServerScriptService"
        },
        "ReplicatedStorage": {
            "$path": "src/ReplicatedStorage"
        },
        "ServerStorage": {
            "$path": "Assets",
            "$ignoreUnknownInstances": true
        },
        "Workspace": {
            "$path": "src/Workspace",
            "$ignoreUnknownInstances": true
        },
        "TextChatService": {
            "$className": "TextChatService",
            "ChatWindowConfiguration": {
                "$className": "ChatWindowConfiguration",
                "$properties": {
                    "Tags": ["StyledUI"],
                    "Attributes": {"Style": {"String": "Primary"}}
                }
            },
            "ChatInputBarConfiguration": {
                "$className": "ChatInputBarConfiguration",
                "$properties": {
                    "Tags": ["StyledUI"],
                    "Attributes": {"Style": {"String": "Secondary"}}
                }
            }
        },
        "Lighting": {
            "$className": "Lighting",
            "$properties": {
                "GlobalShadows": false
            }
        }
    }
}