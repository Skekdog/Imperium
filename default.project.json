{
    "name": "Imperium",
    "emitLegacyScripts": false,

    "tree": {
        "$className": "DataModel",
        "ReplicatedFirst": {
            "Shared": {"$path": "src/ReplicatedFirst/Shared"},
            "Game": {"$path": "src/ReplicatedFirst/Game"},
            "Lobby": {"$path": "src/ReplicatedFirst/Lobby"}
        },
        "ServerScriptService": {
            "Shared": {"$path": "src/ServerScriptService/Shared"},
            "Game": {"$path": "src/ServerScriptService/Game"},
            "Lobby": {"$path": "src/ServerScriptService/Lobby"}
        },
        "ReplicatedStorage": {
            "Shared": {"$path": "src/ReplicatedStorage/Shared"},
            "Game": {"$path": "src/ReplicatedStorage/Game"},
            "Lobby": {"$path": "src/ReplicatedStorage/Lobby"},
            "$properties": {
                "Attributes": {
                    "TimeMilestone": {"Float64": 0},
                    "CurrentPlayer": {"String": ""},
                    "WaitingText": {"String": "Waiting for players..."}
                }
            }
        },
        "ServerStorage": {
            "Shared": {"$path": "Assets/Shared"},
            "Game": {"$path": "Assets/Game"},
            "Lobby": {"$path": "Assets/Lobby"}
        },
        "Lighting": {
            "$className": "Lighting",
            "$properties": {
                "GlobalShadows": false
            },

            "Blur": {
                "$className": "BlurEffect",
                "$properties": {
                    "Size": 64
                }
            }
        },
        "TextChatService": {
            "$className": "TextChatService",
            "$properties": {
                "ChatVersion": "TextChatService"
            }
        },
        "Workspace": {
            "$className": "Workspace",
            "$properties": {
                "StreamingEnabled": false
            }
        },
        "StarterPlayer": {
            "$className": "StarterPlayer",
            "$properties": {
                "CharacterWalkSpeed": 32
            }
        },
        "SoundService": {
            "$path": "src/SoundService"
        }
    }
}